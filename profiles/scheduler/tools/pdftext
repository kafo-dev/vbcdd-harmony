#!/opt/pdf-venv/bin/python
"""Extract text from a PDF, render its pages, or read a scanned PDF.

Usage:
  pdftext text FILE [PAGES]
  pdftext ocr FILE [PAGES]
  pdftext render FILE OUTDIR [PAGES]

PAGES accepts one page or a comma-separated set of pages and ranges, for
example `2` or `1-3,7`. The default is every page.

`text` reads the text layer with PDFium. `ocr` renders each page and reads it
with `tesseract`, using the languages in `PDFTEXT_OCR_LANG` (default `eng`).
`render` writes one PNG per page. A file that needs a password exits with
status 2 and never reads one from the terminal.
"""

import os
import subprocess
import sys
import tempfile

import pypdfium2 as pdfium


def page_numbers(spec, count):
    if not spec:
        return list(range(count))
    numbers = []
    for part in spec.split(","):
        start, _, end = part.partition("-")
        if end:
            numbers.extend(range(int(start) - 1, int(end)))
        else:
            numbers.append(int(start) - 1)
    return [n for n in numbers if 0 <= n < count]


def run_ocr(image_path, lang):
    result = subprocess.run(
        ["tesseract", image_path, "stdout", "-l", lang],
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        raise RuntimeError(result.stderr.strip() or f"tesseract exited {result.returncode}")
    return result.stdout


def emit(text):
    sys.stdout.write(text)
    if text and not text.endswith("\n"):
        sys.stdout.write("\n")


def main(argv):
    if len(argv) < 3:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    mode, path = argv[1], argv[2]
    rest = argv[3:]

    outdir = None
    if mode == "render":
        if not rest:
            print("render needs an output directory", file=sys.stderr)
            return 2
        outdir, rest = rest[0], rest[1:]
    spec = rest[0] if rest else ""

    if mode not in ("text", "ocr", "render"):
        print(f"unknown mode {mode!r}", file=sys.stderr)
        return 2

    try:
        pdf = pdfium.PdfDocument(path)
    except Exception as err:
        print(f"cannot open {path}: {err}", file=sys.stderr)
        return 2

    numbers = page_numbers(spec, len(pdf))

    if mode == "text":
        for number in numbers:
            emit(pdf[number].get_textpage().get_text_range())
        return 0

    if mode == "render":
        os.makedirs(outdir, exist_ok=True)
        for number in numbers:
            image = pdf[number].render(scale=2).to_pil()
            image.save(os.path.join(outdir, f"page-{number + 1:03d}.png"))
        return 0

    lang = os.environ.get("PDFTEXT_OCR_LANG", "eng")
    with tempfile.TemporaryDirectory() as tmp:
        for number in numbers:
            image = pdf[number].render(scale=3).to_pil()
            image_path = os.path.join(tmp, f"page-{number + 1:03d}.png")
            image.save(image_path)
            try:
                emit(run_ocr(image_path, lang))
            except RuntimeError as err:
                print(f"ocr page {number + 1}: {err}", file=sys.stderr)
                return 3
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))